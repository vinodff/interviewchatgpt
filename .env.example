# Production compose settings. Use URL-safe generated passwords (hex recommended).
APP_DOMAIN=interviewwin.example.com
ENVIRONMENT=production
PUBLIC_URL=https://interviewwin.example.com
ALLOWED_ORIGINS=["https://interviewwin.example.com"]
COOKIE_SECURE=true
POSTGRES_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
