ENVIRONMENT=development
# Opt in only on this computer. The ID must belong to an existing saved workspace.
LOCAL_TEST_MODE=false
LOCAL_TEST_USER_ID=
DATABASE_URL=sqlite+aiosqlite:///./data/interviewpilot.db
REDIS_URL=memory://
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COOKIE_SECURE=false
# One-time minute packs. Amounts are in paise and must match frontend/lib/plans.ts.
FREE_MINUTES=2
STARTER_MINUTES=20
PRO_MINUTES=60
VALUE_MINUTES=150
STARTER_PRICE_MINOR=19900
PRO_PRICE_MINOR=49900
VALUE_PRICE_MINOR=99900
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=
# Existing Stripe Pro price setting remains supported.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET=
CASHFREE_ENV=production
CASHFREE_API_VERSION=2023-08-01
