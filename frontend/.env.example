BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Workspace mode is forced to backend in next.config.ts for this
# deployment; a NEXT_PUBLIC_WORKSPACE_MODE=browser env var no longer
# switches it to local preview (Candidate, unlimited minutes).
NEXT_PUBLIC_WORKSPACE_MODE=backend
# Standalone AI credentials belong in server environment variables, never NEXT_PUBLIC_*.
GEMINI_API_KEY=
# Supabase Public Keys for Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://vcpvpzxytleafevindjb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used ONLY by Vercel routes under app/api/supabase/ to read
# the users and usage_buckets tables. Never NEXT_PUBLIC_*, never in code,
# never in the browser bundle. Without it, /api/supabase/me returns 503
# naming this variable.
SUPABASE_SERVICE_ROLE_KEY=

# Streaming microphone uses gemini-3.5-transcribe-live through constrained
# single-use tokens. This model must be available to the same server key.
# It has a provider free tier with project-specific quotas; no billing is enabled here.
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_ANSWER_MODEL=
# Enhanced mode can transcribe and stream a contextual answer in one call.
GEMINI_AUDIO_ANSWER_MODEL=gemini-3.1-flash-lite
# Optional override for Enhanced microphone's short audio transcription requests.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash

